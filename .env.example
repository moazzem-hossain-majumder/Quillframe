# Copy this file to .env and fill in your keys. Never commit .env.
# You need at least ONE text-model key. More keys = a richer model comparison.

# --- Text models (free tiers) ---------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter key (optional): https://openrouter.ai/keys  (use model ids ending in ":free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Which provider's answer is used when only one is needed: gemini | groq | openrouter
TEXT_PRIMARY=gemini

# --- Images ----------------------------------------------------------------
# Pollinations needs no key. Hugging Face is optional: https://huggingface.co/settings/tokens
POLLINATIONS_MODEL=flux
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGES_PER_CAMPAIGN=2

# --- Voice (edge-tts, no key) ----------------------------------------------
# Try bn-BD-NabanitaNeural for Bangla
EDGE_TTS_VOICE=en-US-AriaNeural

# --- Output ----------------------------------------------------------------
OUTPUT_DIR=outputs
