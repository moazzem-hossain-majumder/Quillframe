{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Quillframe: web UI",
      "type": "debugpy",
      "request": "launch",
      "module": "quillframe",
      "args": ["serve"],
      "console": "integratedTerminal"
    },
    {
      "name": "Quillframe: demo campaign",
      "type": "debugpy",
      "request": "launch",
      "module": "quillframe",
      "args": ["campaign", "A Dhaka animation studio launching a short film about river life"],
      "console": "integratedTerminal"
    }
  ]
}
